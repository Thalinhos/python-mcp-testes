# Copie para .env (e NUNCA commite o .env).

# Chaves aceitas pelo servidor, separadas por vírgula (uma por cliente).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEYS=troque-por-uma-chave-longa-e-aleatoria

# Usado pelo cliente_local.py (uma das chaves acima)
MCP_API_KEY=troque-por-uma-chave-longa-e-aleatoria
MCP_URL=http://127.0.0.1:8000/mcp

# Rede do servidor
HOST=127.0.0.1
PORT=8000

# Só para os exemplos com LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 1 = sem sessões em memória (vários workers/instâncias)
# STATELESS=1
